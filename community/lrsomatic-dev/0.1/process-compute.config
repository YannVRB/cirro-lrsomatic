// Compute settings for the lrsomatic dev branch on Cirro (AWS Batch). TEST process.
//
// Smaller than the 1.0 config on purpose. The dev branch's conf/base.config now sizes most
// processes by name from ~30x whole-genome traces (CLAIRS 48 cpus, SEVERUS 64 GB, SAVANA_RUN 128 GB,
// the VEP and fibertools steps, ...), and those values cover what we measured on the P4 pair in run
// 6774e393 (peaks: SAVANA_RUN 80 GiB, SEVERUS 31 GiB). A name selector outranks the label values
// the 1.0 config repeats, so repeating the labels here would change nothing; they are left out.
//
// What this file adds:
//   - a retry rule that also covers an unknown exit status, with up to two retries
//   - a resource cap
//   - every task on Cirro's on-demand queue
//
// Not carried over from 1.0: retryScale (a lost host retried at the SAME size). dev's sizes scale
// with task.attempt, so a lost host is retried on a bigger request. That cost little in 1.0 only
// because Spot hosts were lost; here every task is on-demand, where a lost host is rare.
// Not set on purpose: parameter defaults (lrsomatic takes its parameters on the command line),
// executor, container engine and Slurm settings (Cirro supplies the AWS Batch ones).
//
// CORAL_RECONSTRUCT, CORAL_CYCLE, CORAL_PLOT, AMPLICONCLASSIFIER, PADFOOT, RECONPLOT and
// SHATTERSEEK have their own errorStrategy in conf/modules.config (retry a kill, otherwise
// ignore): a failure there does not stop the run. Their memory and time are NOT measured at full
// size; they run at their label sizes (process_medium for CORAL_RECONSTRUCT, process_low for the
// rest). Check the trace after the first full-size run.

// Publishing to S3: dev's nextflow.config sets workflow.output.copyAttributes = true (keep work-dir mtimes).
// Nextflow 26.04.6 then adds COPY_ATTRIBUTES to the S3 to S3 publish copy, and nf-amazon 3.9.2 rejects it
// ("options are not supported: [COPY_ATTRIBUTES]", run b94197a1, which stopped on the first published file).
// Turned off here; published files get their upload time as modification time.
workflow.output.copyAttributes = false

process {

    // Same rule as 1.0: retry a kill (exit 130-145, 104, 175-177) or an unknown exit status
    // (Integer.MAX_VALUE, which is how a lost AWS Batch host surfaces), otherwise stop.
    errorStrategy = { (task.exitStatus in ((130..145) + 104 + (175..177)) || task.exitStatus == Integer.MAX_VALUE) ? 'retry' : 'finish' }
    maxRetries    = 2

    // Native cap on every cpus/memory/time request. Sarek's values, as in 1.0: the largest request
    // in dev is DEEPSOMATIC_MAKEEXAMPLES at 48 cpus / 192 GB; a second attempt (x2) would be capped
    // at 64 cpus. The values are ASSUMED to fit the on-demand instance families (see
    // docs/compute-sizing.md in this repository).
    resourceLimits = [ cpus: 64, memory: 488.GB, time: 240.h ]

    // Every task on the on-demand queue. A process-level `queue` is ignored by Cirro; the withName
    // selector works (confirmed in run 6774e393, all 60 tasks on Cirro-OnDemand).
    withName: '.*' {
        queue = env('PW_ONDEMAND_JOB_QUEUE')
    }

    // Run 6a568a0c stopped here: Clair3's germline VCF has 31 of 5.76M records with N in REF (for example
    // chr3:16902879 TGTGN), and bcftools norm exits on the first REF mismatch. --check-ref x drops such records.
    // dev's options are repeated unchanged; the selector is dev's own, so this file (loaded last) replaces its ext.args.
    withName: '.*:PHASING_HAPLOTYPING:REJOIN_GERMLINE' {
        ext.args = { '-m +any --output-type z --write-index=tbi --check-ref x' }
    }
}
