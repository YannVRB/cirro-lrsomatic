{
  "id": "process-intgenomicslab-lrsomatic-1-0",
  "parentProcessIds": [
    "ingest_aligned_bam",
    "ingest_unaligned_bam"
  ],
  "childProcessIds": [],
  "dataType": "Genomic Variants (VCF)",
  "name": "Somatic Variant Calling for Long Reads (LRsomatic)",
  "desc": "Somatic variant calling from tumor/normal long-read (ONT or PacBio) BAMs with IntGenomicsLab/lrsomatic",
  "executor": "NEXTFLOW",
  "category": "DNA Sequencing",
  "documentationUrl": "https://<DOCS_SITE>/pipelines/catalog-dna-sequencing/#somatic-variant-calling-for-long-reads-lrsomatic",
  "code": {
    "repository": "GITHUBPUBLIC",
    "script": "main.nf",
    "uri": "yannvrb/lrsomatic",
    "version": "42458112ee927a37c1879a3f23e0fb82ab7b8fdb",
    "executorVersion": "25.10.4"
  },
  "allowMultipleSources": true,
  "usesSampleSheet": true,
  "fileMappingRules": [
    {
      "description": "Somatic small variants (phased)",
      "min": 0,
      "fileNamePatterns": [
        {
          "exampleName": "sampleName/variants/phased/somatic_smallvariants.vcf.gz",
          "description": "VCF",
          "sampleMatchingPattern": "(?P<sampleName>[^/]+)/variants/phased/somatic_smallvariants\\.vcf\\.gz$"
        },
        {
          "exampleName": "sampleName/variants/phased/somatic_smallvariants.vcf.gz.tbi",
          "description": "VCF index",
          "sampleMatchingPattern": "(?P<sampleName>[^/]+)/variants/phased/somatic_smallvariants\\.vcf\\.gz\\.tbi$"
        }
      ]
    },
    {
      "description": "Somatic small variants annotated with VEP",
      "min": 0,
      "fileNamePatterns": [
        {
          "exampleName": "sampleName/vep/somatic/sampleName_SOMATIC_VEP.vcf.gz",
          "description": "VEP-annotated VCF",
          "sampleMatchingPattern": "(?P<sampleName>[^/]+)/vep/somatic/[^/]+_SOMATIC_VEP\\.vcf\\.gz$"
        },
        {
          "exampleName": "sampleName/vep/somatic/sampleName_SOMATIC_VEP.vcf.gz.tbi",
          "description": "VEP-annotated VCF index",
          "sampleMatchingPattern": "(?P<sampleName>[^/]+)/vep/somatic/[^/]+_SOMATIC_VEP\\.vcf\\.gz\\.tbi$"
        }
      ]
    },
    {
      "description": "Per-sample report",
      "min": 0,
      "fileNamePatterns": [
        {
          "exampleName": "sampleName/report/sampleName_report.html",
          "description": "HTML report",
          "sampleMatchingPattern": "(?P<sampleName>[^/]+)/report/[^/]+_report\\.html$"
        }
      ]
    }
  ],
  "computeDefaults": [
    {
      "executor": "NEXTFLOW",
      "json": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-compute.config",
      "name": "Default"
    }
  ],
  "paramMapJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-input.json",
  "preProcessScript": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/preprocess.py",
  "formJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-form.json",
  "webOptimizationJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-output.json"
}
