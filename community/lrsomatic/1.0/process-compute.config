// Compute settings for IntGenomicsLab/lrsomatic on Cirro (AWS Batch).
//
// Deliberately minimal. The pipeline's own conf/base.config already sets cpus/memory/time per
// process label; this file only adds a retry strategy, a resource cap and the few per-process
// overrides that the P3/P4 Slurm execution traces justify. Sizing evidence and assumptions are in
// docs/compute-sizing.md.
//
// Not set here on purpose:
//   - no parameter defaults: lrsomatic requires its parameters on the command line, never via -c
//   - no executor, container-engine or Slurm settings: Cirro supplies the AWS Batch ones (the queue
//     is the one exception, set below to Cirro's on-demand queue)

process {

    // The pipeline's own retry predicate (conf/base.config) plus one addition: retry when the exit
    // status says the task was killed (OOM, signals; exit 130-145, 104, 175-177) or when the exit
    // status is unknown (task.exitStatus == Integer.MAX_VALUE, i.e. no exit code was recorded),
    // otherwise stop. A lost host on AWS Batch ("Host EC2 ... terminated") DOES surface as an
    // unknown exit status (seen 2026-11-17), so it is retried too, with the larger request below,
    // which does not help a lost host. Deterministic failures (a real non-zero exit code
    // outside the list) are not rerun. Memory overrides below scale with task.attempt, so a retry
    // asks for more; maxRetries = 2 bounds the retries and gives three attempts (e.g. SAVANA_RUN
    // 220 / 440 / 488 GB, the last capped by resourceLimits). The pipeline's own maxRetries is 1.
    // aws.batch.maxSpotAttempts is not set here; Cirro's own config sets it to 5.
    errorStrategy = { (task.exitStatus in ((130..145) + 104 + (175..177)) || task.exitStatus == Integer.MAX_VALUE) ? 'retry' : 'finish' }
    maxRetries    = 2

    // Native Nextflow resource capping (24.x+). A helper function declared at the top of a config
    // file is rejected by the stricter config grammar of Nextflow 26.x, so no check_max() here:
    // resourceLimits caps every cpus/memory/time request, including the label defaults in
    // conf/base.config. The values are sarek's and are ASSUMED, not taken from the user's Batch
    // compute environment.
    resourceLimits = [ cpus: 64, memory: 488.GB, time: 240.h ]

    // Observed peak RSS above the label allocation (see docs/compute-sizing.md).
    // 220 GB = 1.25 x the 175.4 GB observed maximum; label default process_high is 72 GB.
    withName: 'SAVANA_RUN' {
        memory = { 220.GB * task.attempt }
    }
    // 96 GB = 1.25 x the 75.4 GB observed maximum; label default process_medium is 36 GB.
    withName: 'SEVERUS' {
        memory = { 96.GB * task.attempt }
    }

    // Every task runs on Cirro's on-demand queue. The first full-size run (P4, 82 GB tumor + 183 GB
    // normal BAMs, 2026-11-17) lost 18 hosts ("Host EC2 ... terminated") on the default queue,
    // each time restarting a multi-hour task that first had to stage a 180 GB BAM. Only
    // MINIMAP2_ALIGN was on-demand and it was never interrupted. PW_ONDEMAND_JOB_QUEUE is a
    // Cirro-specific variable copied from the sarek config. A plain process-level `queue = ...`
    // was ignored (run c6012ed5, 2026-11-18: every re-run task, including 4 lost hosts, ran on
    // Cirro-Spot-d29bb6ed; only the old per-process override reached Cirro-OnDemand-d29bb6ed), so
    // the queue is set through a withName selector, which outranks the process-level default.
    // That this selector now wins is NOT yet confirmed by a run: check the `queue` column of
    // artifacts/trace.txt.
    withName: '.*' {
        queue = env('PW_ONDEMAND_JOB_QUEUE')
    }
}
