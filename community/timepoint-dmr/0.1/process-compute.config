// Compute settings for the timepoint DMR process on Cirro (AWS Batch). TEST process.
//
// Same retry rule, resource cap and on-demand queue as the lrsomatic-dev test process
// (community/lrsomatic-dev/0.1/process-compute.config, where the reasoning is written down; a test keeps the
// two identical). A comparison is a job of minutes: every process runs at the label sizes of the fork's
// conf/base.config. Nothing here sets a size.

// Publishing to S3: see the lrsomatic-dev config; the fork's nextflow.config turns copyAttributes on, and the S3 copy rejects it.
workflow.output.copyAttributes = false

process {

    // Same rule as 1.0: retry a kill (exit 130-145, 104, 175-177) or an unknown exit status
    // (Integer.MAX_VALUE, which is how a lost AWS Batch host surfaces), otherwise stop.
    errorStrategy = { (task.exitStatus in ((130..145) + 104 + (175..177)) || task.exitStatus == Integer.MAX_VALUE) ? 'retry' : 'finish' }
    maxRetries    = 2

    // Native cap on every cpus/memory/time request. Sarek's values, as in 1.0: the largest request
    // in dev is DEEPSOMATIC_MAKEEXAMPLES at 48 cpus / 192 GB; a second attempt (x2) would be capped
    // at 64 cpus. The values are ASSUMED to fit the on-demand instance families (see
    // docs/compute-sizing.md in this repository).
    resourceLimits = [ cpus: 64, memory: 488.GB, time: 240.h ]

    // Every task on the on-demand queue. A process-level `queue` is ignored by Cirro; the withName
    // selector works (confirmed in run 6774e393, all 60 tasks on Cirro-OnDemand).
    withName: '.*' {
        queue = env('PW_ONDEMAND_JOB_QUEUE')
    }

    // Matches nothing here; kept so the two files stay identical (see the lrsomatic-dev config).
    withName: '.*:PHASING_HAPLOTYPING:REJOIN_GERMLINE' {
        ext.args = { '-m +any --output-type z --write-index=tbi --check-ref x' }
    }
}
